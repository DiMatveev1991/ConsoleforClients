{
  "ConnectionStrings": {
    // Впиши сюда реальную строку подключения к БД Express.
    "Express": "Server=YOUR_SERVER;Database=Express;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=True"
  },

  "ContragentService": {
    // Базовый адрес сервиса ИНН и путь эндпоинта (из swagger).
    // Итоговый вызов: {BaseUrl}{Path}?inn=...&kpp=...&showMainContragent=true
    "BaseUrl": "https://contragents.major-express.ru",
    "Path": "/api/contragent",
    "ShowMainContragent": true,
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    // Сколько запросов к сервису выполнять одновременно.
    "Concurrency": 10
  },

  "Enrichment": {
    // Фильтр выборки клиентов.
    "AgentCode": 304,
    "ClientDepartment": 1,

    // Соответствие строкового типа контрагента из сервиса числовому ContragentTypeId в БД.
    // ПРОВЕРЬ значения по своему справочнику типов контрагентов!
    "ContragentTypeMap": {
      "LEGAL": 1,
      "INDIVIDUAL": 2
    },

    // Должность для ИП, если сервис вернул только individuaL_FIO без managment.
    "IndividualPositionName": "Индивидуальный предприниматель",

    // Ограничение количества обрабатываемых клиентов за запуск (0 = без ограничения).
    "MaxClients": 0
  },

  "LogFile": "enrichment-log.txt"
}
